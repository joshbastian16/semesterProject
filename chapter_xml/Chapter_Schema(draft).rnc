datatypes xsd = "http://www.w3.org/2001/XMLSchema-datatypes"

start = chapter
chapter = element chapter{title, author, body}

title = element title {text}
author = element author {text}

body = element body { (page | pageBreak)* }
pageBreak = element pageBreak {empty}

page = element page {n, mixed{(balloon | caption)*}}
n = attribute n {xsd:int}
balloon = element balloon {attribute type{"speech" | "thought"},who, mixed{bold*}}
caption = element caption {attribute type {"information" | "narration"}, who?, mixed{bold*}}

who = attribute who {text}
bold = element bold {text}




