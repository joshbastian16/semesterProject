            </bubble>
            <bubble type="thought" thtNum="4" who="Sung Jin-Woo" >
                <unique ans="n"/> IF WE TRIED SOMETHING, THEY WERE READY TO STRIKE US DOWN! 
            </bubble>
            <bubble type="speech" spNum="15" who="Yoo Jin-Ho">
