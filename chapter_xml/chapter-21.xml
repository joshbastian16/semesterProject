            <bubble type="speech" spNum="12" who="Yoo Jin-Ho">
                <unique ans="n"/> THE ENTRANCE...! 
            </bubble>
            <bubble type="speech" spNum="13" who="Yoo Jin-Ho">
                <unique ans="n"/> THESE SONS OF BITCHES TRIED TO KILL US!!
            </bubble>
            <bubble type="speech" spNum="14" who="Yoo Jin-Ho">
                <unique ans="n"/> THEY'RE TRYING TO KILL US BOTH JUST BECUASE OF SOME MANA CRYSTALS! 
            </bubble>
            <bubble type="thought" thtNum="3" who="Sung Jin-Woo">
